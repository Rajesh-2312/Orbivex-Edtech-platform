# Set these in Render's Environment dashboard. Local npm start loads ../.env.
NODE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
# Optional AI providers. At least one is needed for AI features; NVIDIA is
# additionally required for embeddings/RAG.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
AI_PROVIDER_ORDER=openrouter,nvidia
AI_MAX_CONCURRENT=8
# Optional email notifications: use a verified sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=Orbivex <noreply@YOUR_VERIFIED_DOMAIN>
SUPER_ADMIN_EMAIL=YOUR_ADMIN_EMAIL
