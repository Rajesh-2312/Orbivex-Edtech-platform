# ─── Supabase (Required) ───
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Frontend (Vite prefix) ───
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_KEY=YOUR_ANON_KEY
VITE_API_URL=http://localhost:3001

# ─── JWT ───
JWT_SECRET=your-ultra-secret-jwt-key-change-this

# ─── Ollama (fallback LLM) ───
OLLAMA_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_NOTES_MODEL=mistral

# ─── NVIDIA NIM (primary LLM + Embeddings — leave key empty to disable) ───
# Get a free key at https://build.nvidia.com → pick a chat model → "Get API Key"
# Embedding model (1024-dim, used for RAG / semantic search):
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Redis (optional) ───
REDIS_URL=redis://redis:6379

# ─── Server ───
NODE_ENV=development
PORT=3001

# ─── Razorpay (Revenue) ───
# Get from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Plan IDs — create in Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_PLAN_STARTER_MONTHLY=plan_xxxxxxxxx
RAZORPAY_PLAN_GROWTH_MONTHLY=plan_xxxxxxxxx
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=plan_xxxxxxxxx
RAZORPAY_PLAN_STARTER_ANNUAL=plan_xxxxxxxxx
RAZORPAY_PLAN_GROWTH_ANNUAL=plan_xxxxxxxxx
RAZORPAY_PLAN_ENTERPRISE_ANNUAL=plan_xxxxxxxxx

# ─── Email (Revenue notifications) ───
# Get from https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Orbivex <sales@orbivex.com>

# ─── Super Admin (Founder) ───
SUPER_ADMIN_EMAIL=marojurajesh1234@gmail.com

# ─── Billing Enforcement ───
# Set to 'false' during development to skip subscription checks
BILLING_ENFORCEMENT=false

# ─── CORS (Production only) ───
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-production-domain.com
