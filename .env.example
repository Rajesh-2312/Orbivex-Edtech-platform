# ─── Supabase (Required) ───
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Frontend (Vite prefix) ───
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_KEY=YOUR_ANON_KEY
VITE_API_URL=http://localhost:3001

# ─── JWT ───
JWT_SECRET=your-ultra-secret-jwt-key-change-this

# ─── Ollama (fallback LLM) ───
OLLAMA_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_NOTES_MODEL=mistral

# ─── NVIDIA NIM (primary LLM — leave key empty to disable) ───
# Get a free key at https://build.nvidia.com → pick a chat model → "Get API Key"
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Redis (optional) ───
REDIS_URL=redis://redis:6379

# ─── Server ───
NODE_ENV=development
PORT=3001
