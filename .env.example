# ─── Supabase (Required) ───
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Frontend (Vite prefix) ───
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_KEY=YOUR_ANON_KEY
VITE_API_URL=/api

# ─── JWT ───
JWT_SECRET=your-ultra-secret-jwt-key-change-this

# ─── LLM throughput ───
# Max simultaneous LLM calls across all students (semaphore in config/ai.js).
# Per Node process; raise only as far as your provider absorbs it. Default 8.
AI_MAX_CONCURRENT=32

# ─── LLM provider order ───
# Comma-separated; first healthy provider wins, rest are fallbacks.
# Embeddings always use NVIDIA regardless of this setting.
AI_PROVIDER_ORDER=openrouter,nvidia

# ─── NVIDIA NIM (LLM + Embeddings) ───
# Get a free key at https://build.nvidia.com → pick a chat model → "Get API Key"
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_STANDARD=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_ADVANCED=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Embedding model (1024-dim, used for RAG / semantic search — NIM only):
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ─── OpenRouter (LLM) ───
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_STANDARD=meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL_ADVANCED=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://orbivex.com

# ─── Server ───
NODE_ENV=development
PORT=3001

# ─── Email (notifications) ───
# Get from https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Orbivex <sales@orbivex.com>

# ─── Super Admin (Founder) ───
SUPER_ADMIN_EMAIL=marojurajesh1234@gmail.com

# ─── CORS (Production only) ───
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-production-domain.com
