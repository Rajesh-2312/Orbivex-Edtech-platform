# Local development: leave /api so Vite proxies requests to localhost:3001.
# Vercel: set this to https://YOUR_SERVICE.onrender.com/api and rebuild.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Public anon or publishable key only. Never use a service-role/secret key here.
VITE_SUPABASE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
